# Frontend environment — copy to .env.local (never commit the real file).
# Browser talks to the backend via its published host port (8100).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api/v1
NEXT_PUBLIC_PRODUCT_NAME=CoreOps

# Feature flags (default off). Attendance Corrections is deferred until
# biometric integration or automated attendance capture exists.
NEXT_PUBLIC_FEATURE_ATTENDANCE_CORRECTIONS=false

# Split-day work reports: shows the Full Day / Split Day selector on the report
# form. Mirror of the backend REPORT_DAY_PARTS_ENABLED — keep the two in step.
NEXT_PUBLIC_REPORT_DAY_PARTS_ENABLED=true

# Settings → Biometric (EasyTime code ↔ employee mappings) needs no frontend
# flag: the tab is always shown to users who can reach Settings, and the
# endpoints behind it are project_manager-only. Punch ingestion has its own
# backend switch (EASYTIME_INGESTION_ENABLED). Never put an EasyTime credential
# in a NEXT_PUBLIC_ variable.
