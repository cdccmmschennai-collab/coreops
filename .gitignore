# ---- Python (backend) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Node / Next (frontend) ----
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Environment & secrets (commit ONLY *.example files) ----
.env
.env.*
!.env.example
!*.env.example
!.env.local.example
*.key
*.pem
secrets/

# ---- Docker / data volumes ----
**/pgdata/
**/redisdata/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
.Rhistory

# DB dumps / backups (regenerable from migrations — never commit)
*backup*.sql
*.dump
Datas/
rbac_evidence/
verify_rbac.js

*.log
*.tmp
.env
.env.local
backend/celerybeat-schedule*

# ---- EasyTime connector (admin PC; secrets + local sync state) ----
connectors/easytime/.env
connectors/easytime/*.db
connectors/easytime/logs/
connectors/easytime/probe-output/
connectors/easytime/.venv/
connectors/easytime/dist/
# Phase 3 local sync state: state.db, sync.lock. Never committed - a cursor is
# specific to one PC, and committing one would make another machine think it
# had already synced a window it has never seen.
connectors/easytime/data/
connectors/easytime/*.lock
