# CoreOps EasyTime connector - ADMINISTRATOR PC ONLY.
#   copy connectors/easytime/.env.example  ->  connectors/easytime/.env
#
# This file lives on the Windows PC that runs EasyTime Pro. It is NEVER copied
# to the CoreOps VPS: on the VPS, localhost is the VPS itself, so nothing there
# can reach EasyTime. The VPS only receives normalized punches over HTTPS.
#
# NEVER COMMIT THE REAL .env - it is git-ignored, keep it that way.

# ---------------------------------------------------------------------------
# EasyTime Pro (local)
# ---------------------------------------------------------------------------
# The address the EasyTime web UI opens on, WITHOUT a trailing slash.
# Read the real port off the browser address bar on the admin PC.
EASYTIME_BASE_URL=http://127.0.0.1

# Use a DEDICATED integration account with the minimum permissions needed to
# read transactions. Do not use a person's normal administrator login.
EASYTIME_USERNAME=coreops_integration
EASYTIME_PASSWORD=

# jwt | token. Which one the installed version accepts is confirmed by
# `python probe.py --discover` - do not assume.
EASYTIME_AUTH_MODE=jwt

# Authorization header prefix. Blank = the default for the mode above
# ("JWT" for jwt, "Token" for token). Set to "none" for a bare token.
EASYTIME_AUTH_HEADER_SCHEME=

# Endpoint paths. Leave blank to let the client try its candidate list; PIN THEM
# to the ones the probe confirmed so the sync loop never guesses at runtime.
# EASYTIME_AUTH_PATH=/api/jwt-api-token-auth/
# EASYTIME_REFRESH_PATH=/api/jwt-api-token-refresh/
# EASYTIME_TRANSACTIONS_PATH=/iclock/api/transactions/

# EasyTime on the admin PC is usually plain HTTP or a self-signed certificate.
EASYTIME_VERIFY_SSL=false
EASYTIME_TIMEOUT_SECONDS=30
EASYTIME_RETRIES=3
EASYTIME_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# CoreOps backend (used by sync.py from Phase 3; probe.py never writes anywhere)
#
#     POST {COREOPS_API_URL}/integrations/easytime/punches/batch
#     X-CoreOps-Connector-Token: {COREOPS_CONNECTOR_TOKEN}
#
# The token travels in that header only - never in a URL, a query string or an
# Authorization header.
# ---------------------------------------------------------------------------
COREOPS_API_URL=https://coreops.cdccmms.com/api/v1
# Long random shared secret, must match EASYTIME_CONNECTOR_TOKEN in the VPS .env.
# The backend refuses to start if ingestion is enabled in production with a
# token shorter than 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COREOPS_CONNECTOR_TOKEN=

COREOPS_TIMEOUT_SECONDS=30
# Total attempts per batch, not additional retries. 4 = immediate, ~2s, ~5s, ~10s.
COREOPS_RETRIES=4

# Identity of THIS connector, written to every biometric_sync_batches row.
# Defaults to the PC hostname; pin it so a machine rename does not silently
# split one connector's history in two.
CONNECTOR_ID=admin-pc-01

# ---------------------------------------------------------------------------
# Synchronisation (Phase 3)
# ---------------------------------------------------------------------------
# How often the Windows scheduled task fires. The connector itself is one-shot
# and never reads this - it is documentation for whoever creates the task.
SYNC_INTERVAL_SECONDS=300

# Re-fetch this many minutes before the last cursor so a punch that was uploaded
# late is not missed. Duplicates are absorbed by the DB unique constraint.
SYNC_LOOKBACK_MINUTES=15

# The daily reconciliation pass re-sends this many calendar days. This is what
# actually recovers punches EasyTime uploaded the following morning.
SYNC_RECONCILIATION_DAYS=7

# First run only, when no cursor exists yet. NEVER "all of history".
SYNC_FIRST_RUN_LOOKBACK_HOURS=24

# Hard ceiling on any single fetch window. Guards against a long outage, a
# typo'd --from-date, and a backfill that means "last week" and says last year.
SYNC_MAX_RANGE_DAYS=31

# Punches per POST. The backend rejects anything over 1000 outright.
SYNC_BATCH_SIZE=500

# Local file layout. Blank = C:\ProgramData\CoreOps\EasyTimeConnector\... on an
# installed machine, ./data and ./logs in a development checkout.
# SYNC_STATE_PATH=C:\ProgramData\CoreOps\EasyTimeConnector\data\state.db
# SYNC_LOG_DIR=C:\ProgramData\CoreOps\EasyTimeConnector\logs
# SYNC_LOCK_PATH=C:\ProgramData\CoreOps\EasyTimeConnector\data\sync.lock

# Timezone the naive EasyTime timestamps are interpreted in.
TIMEZONE=Asia/Kolkata
